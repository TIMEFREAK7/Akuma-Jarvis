    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-paper": "^5.10.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-markdown-display": "^7.0.0",
    "zustand": "^4.4.0",
    "wouter-native": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
