  "description": "Vortex AI OS - OnePlus 11 Edition. Completely free, on-device AI assistant powered by Gemma-3n-E4B-it",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
